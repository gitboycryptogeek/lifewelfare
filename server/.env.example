# Server
NODE_ENV=development
PORT=5000

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.neon.tech/mlc_welfare?sslmode=require

# JWT
JWT_SECRET=change_this_to_a_random_32+_char_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=change_this_to_another_random_32+_char_string
JWT_REFRESH_EXPIRES_IN=7d
JWT_OTP_SECRET=change_this_to_a_random_32+_char_string_for_otp

# Email (Nodemailer - Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@mylife-companion.com
SMTP_PASS=your_gmail_app_password
FROM_EMAIL="My Life Companion <notifications@mylife-companion.com>"

# SMS (Africa's Talking)
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=MYLIFECOMP

# App URLs
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Membership Number Prefix
MEMBERSHIP_PREFIX=WEL

# OTP / 2FA — set to true to skip all OTP verification (useful for local dev)
DISABLE_OTP=false

# Seed admin credentials (used by npm run seed)
SEED_ADMIN_PHONE=+254118043715
SEED_ADMIN_PASSWORD=Admin@1234
